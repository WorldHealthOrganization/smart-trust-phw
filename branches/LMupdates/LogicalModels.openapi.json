{
  "openapi": "3.1.0",
  "info": {
    "title": "Logical Model Enumeration Schema API",
    "description": "JSON Schema defining the structure of the Logical Model enumeration endpoint response",
    "version": "1.0.0"
  },
  "paths": {
    "/LogicalModels.schema.json": {
      "get": {
        "summary": "JSON Schema definition for the Logical Model LogicalModels",
        "description": "This endpoint serves the JSON Schema definition for the Logical Model LogicalModels.",
        "responses": {
          "200": {
            "description": "The JSON Schema for LogicalModels",
            "content": {
              "application/schema+json": {
                "schema": {
                  "$ref": "./LogicalModels.schema.json"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LogicalModels": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "#/LogicalModels.schema.json",
        "title": "Logical Model Enumeration Schema",
        "description": "JSON Schema defining the structure of the Logical Model enumeration endpoint response",
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "logical_model"
          },
          "count": {
            "type": "integer"
          },
          "schemas": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "filename": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "logicalModelUrl": {
                  "type": "string"
                },
                "propertyCount": {
                  "type": "integer"
                }
              },
              "required": [
                "filename",
                "title",
                "url"
              ]
            }
          }
        },
        "required": [
          "type",
          "count",
          "schemas"
        ],
        "example": {
          "type": "logical_model",
          "count": 14,
          "schemas": [
            {
              "filename": "StructureDefinition-DVCMin.schema.json",
              "id": "http://smart.who.int/base/StructureDefinition-DVCMin.schema.json",
              "title": "DVC HCERT Payload",
              "description": "Minimal DVC payload for use within an HCERT Payload",
              "url": "./StructureDefinition-DVCMin.schema.json",
              "propertyCount": 12
            },
            {
              "filename": "StructureDefinition-DVCPreQual.schema.json",
              "id": "http://smart.who.int/base/StructureDefinition-DVCPreQual.schema.json",
              "title": "PreQual",
              "description": "Data elements for the Digital Vaccine Certificate using WHO Vaccine PreQualification database",
              "url": "./StructureDefinition-DVCPreQual.schema.json",
              "propertyCount": 23
            },
            {
              "filename": "StructureDefinition-VaccineDetailsSD.schema.json",
              "id": "http://smart.who.int/base/StructureDefinition-VaccineDetailsSD.schema.json",
              "title": "DVC Vaccine Details with Selective Disclosure",
              "description": "DVC Vaccine Details with Selective Disclosure",
              "url": "./StructureDefinition-VaccineDetailsSD.schema.json",
              "propertyCount": 22
            },
            {
              "filename": "StructureDefinition-VerifiableHealthLinkPayload.schema.json",
              "id": "http://smart.who.int/base/StructureDefinition-VerifiableHealthLinkPayload.schema.json",
              "title": "Verifiable Health Link Payload (DRAFT)",
              "description": "Verifiable Health Link Payload (DRAFT)\n\nThis logical model constrains the Health Link Payload for a Verifiable Health Link\n",
              "url": "./StructureDefinition-VerifiableHealthLinkPayload.schema.json",
              "propertyCount": 10
            },
            {
              "filename": "StructureDefinition-HealthLinkPayload.schema.json",
              "id": "http://smart.who.int/base/StructureDefinition-HealthLinkPayload.schema.json",
              "title": "Health Link Payload (DRAFT)",
              "description": "Health Link Payload (DRAFT)\n\nA Health Link URI is generated from this payload according to the algorithm documented [here](https://build.fhir.org/ig/HL7/smart-health-cards-and-links/links-specification.html#smart-health-links-sharing-application-generates-a-smart-health-link-uri)\n\n\n",
              "url": "./StructureDefinition-HealthLinkPayload.schema.json",
              "propertyCount": 8
            },
            {
              "filename": "StructureDefinition-DVCMinPreQual.schema.json",
              "id": "http://smart.who.int/base/StructureDefinition-DVCMinPreQual.schema.json",
              "title": "",
              "description": "DVC payload minimized  for use within an HCERT Payload with the WHO PreQual Vaccine Database",
              "url": "./StructureDefinition-DVCMinPreQual.schema.json",
              "propertyCount": 12
            },
            {
              "filename": "StructureDefinition-DVCMinVaccineDetails.schema.json",
              "id": "http://smart.who.int/base/StructureDefinition-DVCMinVaccineDetails.schema.json",
              "title": "DVC HCert Vaccine Details (Minimal)",
              "description": "DVC Vaccine Details for a minimal DVC payload for use within an HCERT Payload",
              "url": "./StructureDefinition-DVCMinVaccineDetails.schema.json",
              "propertyCount": 6
            },
            {
              "filename": "StructureDefinition-DVCSD.schema.json",
              "id": "http://smart.who.int/base/StructureDefinition-DVCSD.schema.json",
              "title": "DVC with Selective Disclosure",
              "description": "DVC with Selective Disclosure",
              "url": "./StructureDefinition-DVCSD.schema.json",
              "propertyCount": 27
            },
            {
              "filename": "StructureDefinition-DVCVaccineDetails.schema.json",
              "id": "http://smart.who.int/base/StructureDefinition-DVCVaccineDetails.schema.json",
              "title": "DVC - Vaccine Details",
              "description": "Vaccine Data elements for the Digital Vaccination Certificates",
              "url": "./StructureDefinition-DVCVaccineDetails.schema.json",
              "propertyCount": 8
            },
            {
              "filename": "StructureDefinition-DVCMinVaccineDetailsPreQual.schema.json",
              "id": "http://smart.who.int/base/StructureDefinition-DVCMinVaccineDetailsPreQual.schema.json",
              "title": "DVC HCERT Payload for PreQual DB",
              "description": "DVC payload for a minimal DVC for use within an HCERT Payload using the WHO PreQual Vaccine Database",
              "url": "./StructureDefinition-DVCMinVaccineDetailsPreQual.schema.json",
              "propertyCount": 8
            },
            {
              "filename": "StructureDefinition-DVC.schema.json",
              "id": "http://smart.who.int/base/StructureDefinition-DVC.schema.json",
              "title": "DVC",
              "description": "Data elements for Digital Vaccination Certificate.",
              "url": "./StructureDefinition-DVC.schema.json",
              "propertyCount": 23
            },
            {
              "filename": "StructureDefinition-DVCVaccineDetailsPreQual.schema.json",
              "id": "http://smart.who.int/base/StructureDefinition-DVCVaccineDetailsPreQual.schema.json",
              "title": "PreQual - Vaccine Details",
              "description": "Vaccine Data elements from the Pre Qual Database",
              "url": "./StructureDefinition-DVCVaccineDetailsPreQual.schema.json",
              "propertyCount": 8
            },
            {
              "filename": "StructureDefinition-SMARTHealthLinkPayload.schema.json",
              "id": "http://smart.who.int/base/StructureDefinition-SMARTHealthLinkPayload.schema.json",
              "title": "SMART Health Link Payload (DRAFT)",
              "description": "SMART Health Link Payload (DRAFT)\n\nThis logical model constrains the Health Link Payload for a SMART Health Link\n\nA SMART Health Link URI is generated from this payload according to the algorithm documented [here](https://build.fhir.org/ig/HL7/smart-health-cards-and-links/links-specification.html#smart-health-links-sharing-application-generates-a-smart-health-link-uri)\n\n",
              "url": "./StructureDefinition-SMARTHealthLinkPayload.schema.json",
              "propertyCount": 8
            },
            {
              "filename": "StructureDefinition-SmartHealthLink.schema.json",
              "id": "http://smart.who.int/base/StructureDefinition-SmartHealthLink.schema.json",
              "title": "Smart Health Link (DRAFT)",
              "description": "Smart Health Link URI (DRAFT)\n\nLogical Model to represent a SMART Health Link as its URI.  It is generated from the content of the SMART Health Link Payload.\n\n\n",
              "url": "./StructureDefinition-SmartHealthLink.schema.json",
              "propertyCount": 2
            }
          ]
        }
      }
    }
  }
}