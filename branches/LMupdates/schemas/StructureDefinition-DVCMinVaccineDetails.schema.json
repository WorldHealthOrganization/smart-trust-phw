{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://smart.who.int/base/StructureDefinition-DVCMinVaccineDetails.schema.json",
  "title": "DVC HCert Vaccine Details (Minimal)",
  "description": "DVC Vaccine Details for a minimal DVC payload for use within an HCERT Payload",
  "type": "object",
  "properties": {
    "resourceType": {
      "type": "string",
      "const": "DVCMinVaccineDetails",
      "description": "Resource type identifier for DVCMinVaccineDetails logical model"
    },
    "vp": {
      "type": "string",
      "description": "Vaccine Product ID"
    },
    "dt": {
      "type": "string",
      "format": "date",
      "description": "Date of vaccination"
    },
    "cn": {
      "type": "string",
      "description": "Name of supervising clinician"
    },
    "is": {
      "type": "string",
      "description": "Certificate issuer id (referenced organization)"
    },
    "bo": {
      "type": "string",
      "description": "Batch No"
    }
  },
  "required": [
    "resourceType",
    "vp",
    "dt",
    "bo"
  ],
  "resourceDefinition": "http://smart.who.int/trust-phw/StructureDefinition/DVCMinVaccineDetails",
  "fhir:parent": "http://hl7.org/fhir/StructureDefinition/Base"
}