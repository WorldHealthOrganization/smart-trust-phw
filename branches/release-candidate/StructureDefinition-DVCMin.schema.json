{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://smart.who.int/base/StructureDefinition-DVCMin.schema.json",
  "title": "DVC HCERT Payload",
  "description": "Mininmial DVC payload for use within an HCERT Payload",
  "type": "object",
  "properties": {
    "resourceType": {
      "type": "string",
      "const": "DVCMin",
      "description": "Resource type identifier for DVCMin logical model"
    },
    "n": {
      "type": "string",
      "description": "Person name"
    },
    "dob": {
      "type": "string",
      "format": "date",
      "description": "Date of birth in YYYY-MM-DD format"
    },
    "s": {
      "type": "string",
      "description": "Sex"
    },
    "ntl": {
      "type": "string",
      "description": "Nationality"
    },
    "nid": {
      "type": "string",
      "description": "National Identification Document"
    },
    "ndt": {
      "$ref": "ValueSet-v2-0203.schema.json",
      "description": "National ID Document Type"
    },
    "gn": {
      "type": "string",
      "description": "Parent or Guardian Name"
    },
    "v": {
      "type": "array",
      "items": {
        "$ref": "http://smart.who.int/base/StructureDefinition-DVCMinVaccineDetails.schema.json"
      },
      "minItems": 1,
      "description": "Vaccine Details"
    }
  },
  "required": [
    "resourceType",
    "n",
    "dob",
    "v"
  ],
  "resourceDefinition": "http://smart.who.int/trust-phw/StructureDefinition/DVCMin",
  "fhir:parent": "http://hl7.org/fhir/StructureDefinition/Base"
}