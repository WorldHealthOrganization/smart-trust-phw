            {
              "filename": "ValueSet-HL.TYPE.schema.json",
              "id": "http://smart.who.int/trust-phw/ValueSet-HL.TYPE.schema.json",
              "title": "HL.TYPE ValueSet  Schema",
              "description": "JSON Schema for HL.TYPE ValueSet  ValueSet codes. Generated from FHIR expansions using IRI format.",
              "url": "./ValueSet-HL.TYPE.schema.json",
              "valueSetUrl": "http://smart.who.int/trust-phw/ValueSet/HL.TYPE",
              "codeCount": 2
            }
          ]
        }
      }
